extends ../../layouts/user/default.pug


block main
  main.dashboard
    .container

      // ---------- HERO SECTION ----------
      section.hero
        .hero__content
          span.hero__subtitle TRANG CHỦ
          h1.hero__title Chào mừng trở lại!
          p.hero__desc
            | Đặt xe, giữ chỗ đỗ và lập lịch sạc chỉ trong vài giây — kết nối mọi điểm đến tại ĐHQG-HCM.
        .hero__status
          .status-badge
            i.fa-solid.fa-bolt
            .status-text
              span TRẠNG THÁI HỆ THỐNG
              strong #{hubActive}/#{hubTotal} Hubs Hoạt động

      // ---------- DỊCH VỤ CHÍNH ----------
      section.services
        .section-header
          .section-header__left
            h2.section-title Dịch vụ chính
            p.section-desc Khám phá các tiện ích di chuyển thông minh trong khu đô thị ĐHQG-HCM

        .services__grid

          // Card 1 — Đặt xe đưa đón
          .service-card
            .service-card__top
              .service-card__icon.icon--green
                i.fa-solid.fa-motorcycle
            h3.service-card__title Đặt xe dùng chung
            p.service-card__desc
              | Khởi hành êm ái trên những chiếc xe điện sẵn sàng chờ bạn ở mọi điểm dừng.
            a.service-card__link(href="/shared-vehicle/book")
              | Tìm xe
              i.fa-solid.fa-arrow-right

          // Card 2 — Đặt chỗ đỗ
          .service-card
            .service-card__top
              .service-card__icon.icon--blue
                i.fa-solid.fa-square-parking
            h3.service-card__title Đặt chỗ đỗ
            p.service-card__desc
              | An tâm có sẵn chỗ đỗ gọn gàng tại Hub trước mỗi ca học hay buổi về KTX.
            a.service-card__link(href="/book/parking")
              | Đặt chỗ
              i.fa-solid.fa-arrow-right

          // Card 3 — Lập lịch sạc
          .service-card
            .service-card__top
              .service-card__icon.icon--purple
                i.fa-solid.fa-bolt
            h3.service-card__title Lập lịch sạc
            p.service-card__desc
              | Gửi gắm chiếc xe cá nhân vào khung giờ sạc lý tưởng, sẵn sàng nạp đầy pin đúng lúc.
            a.service-card__link(href="/book/charging/schedule")
              | Đăng ký sạc
              i.fa-solid.fa-arrow-right

          // Card 4 — Hoạt động & Lịch sử
          .service-card
            .service-card__top
              .service-card__icon.icon--orange
                i.fa-solid.fa-clock-rotate-left
            h3.service-card__title Hoạt động &amp; Lịch sử
            p.service-card__desc
              | Theo dõi chuyến đi đang chạy, lịch đặt chỗ hiện tại và lịch sử giao dịch.
            a.service-card__link(href="/activity/active")
              | Xem hoạt động
              i.fa-solid.fa-arrow-right

      